# Environment Configuration for Weather Web Service
# Copy this file to .env and customize the values for your deployment
# Validates: Requirements 8.4, 12.3

# ============================================================================
# Flask Configuration
# ============================================================================

# FLASK_ENV: Application environment mode
# Options:
#   - development: Enables debug mode, auto-reload, detailed error pages
#   - production: Disables debug features, optimizes for performance
# Default: production
# IMPORTANT: Always use 'production' in production deployments!
FLASK_ENV=production

# ============================================================================
# Logging Configuration
# ============================================================================

# LOG_LEVEL: Minimum log level to output
# Options (from most to least verbose):
#   - DEBUG: Detailed diagnostic information
#   - INFO: General informational messages (recommended for production)
#   - WARNING: Warning messages for potentially harmful situations
#   - ERROR: Error messages for failures
#   - CRITICAL: Critical errors requiring immediate attention
# Default: INFO
# Validates: Requirements 12.3, 12.4
LOG_LEVEL=INFO

# ============================================================================
# Security Configuration
# ============================================================================

# SECRET_KEY: Secret key for Flask session encryption and CSRF protection
# CRITICAL: Generate a secure random key for production!
# 
# Generate a secure key using:
#   python -c "import secrets; print(secrets.token_hex(32))"
# 
# Example output: a1b2c3d4e5f6...
# 
# NEVER commit your actual secret key to version control!
# NEVER use the default value in production!
# Default: dev-secret-key (INSECURE - for development only)
SECRET_KEY=your-secret-key-here

# ============================================================================
# Cache Configuration
# ============================================================================

# CACHE_TTL: Time-to-live for cached data in seconds
# Weather data and location lookups are cached to improve performance
# and reduce load on external APIs.
# 
# Recommended values:
#   - 300 (5 minutes): Good balance for weather data
#   - 600 (10 minutes): For less frequently changing data
#   - 60 (1 minute): For rapidly changing data
# Default: 300
# Validates: Requirements 10.3
CACHE_TTL=300

# ============================================================================
# Request Configuration
# ============================================================================

# REQUEST_TIMEOUT: HTTP request timeout in seconds
# Maximum time to wait for responses from external APIs
# (weather.gov, Nominatim geocoding)
# 
# Recommended values:
#   - 10: Standard timeout (recommended)
#   - 5: Faster timeout for better user experience (may cause failures)
#   - 30: Longer timeout for slow connections
# Default: 10
REQUEST_TIMEOUT=10

# ============================================================================
# CORS Configuration
# ============================================================================

# CORS_ORIGINS: Allowed origins for Cross-Origin Resource Sharing
# Controls which domains can make API requests to this service
# 
# Options:
#   - *: Allow all origins (development only!)
#   - https://example.com: Single domain
#   - https://example.com,https://app.example.com: Multiple domains (comma-separated)
# 
# IMPORTANT: In production, restrict to your specific domain(s)!
# Example for production: https://weather.yourdomain.com
# Default: * (allow all - for development only)
# Validates: Requirements 9.4
CORS_ORIGINS=*

# ============================================================================
# Optional Configuration
# ============================================================================

# PORT: Port to expose the Flask application
# Only used when running the application directly (not with Docker)
# Docker Compose uses port 5000 internally regardless of this setting
# Default: 5000
# PORT=5000

# NOMINATIM_USER_AGENT: Custom user agent for Nominatim API requests
# Format: AppName/Version (contact@email.com)
# Default: WeatherWebService/1.0
# NOMINATIM_USER_AGENT=YourApp/1.0 (your@email.com)
